rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user can read only their own access record.
    // No client can create, modify or delete authorisation records.
    match /authorisedUsers/{uid} {
      allow get: if request.auth != null
                 && request.auth.uid == uid
                 && request.auth.token.email_verified == true;
      allow list, create, update, delete: if false;
    }
    // All other data is denied by default. Add narrowly scoped rules only
    // after the corresponding tool backend and data model have been reviewed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}